# AI-PB environment variables.
# Copy to .env.local (`cp .env.sample .env.local`) and fill in what you use. Every value is optional:
# with nothing set the app runs on demo data and rule-based answers. Never commit .env.local.
# On Fly, put secrets with `fly secrets set NAME=value`; non-secret values live in fly.toml [env].

# ── LLM (pick one provider) ──────────────────────────────────────────────
# anthropic | openai | openrouter
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# model per agent, in the chosen provider's naming
ORCHESTRATOR_MODEL=claude-haiku-4-5
PORTFOLIO_MODEL=claude-sonnet-5
EVIDENCE_MODEL=claude-sonnet-5
SYNTHESIZER_MODEL=claude-sonnet-5
CRITIC_MODEL=claude-haiku-4-5

# ── Decision model (router / verification yes-no questions) ─────────────
# jev (needs TYPESAFE_API_KEY) | llm
DECISION_PROVIDER=jev
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai
# ROUTING_THRESHOLD=0.7
# VERIFICATION_THRESHOLD=0.3

# ── Owner login (one passcode, same ledger on every device) ─────────────
# 8+ characters. Unset = feature off. On Fly: fly secrets set OWNER_PASSCODE='...'
# Also derives the secret MCP connector URL (/api/mcp/<token>, shown on /assets after login) for the Claude app.
OWNER_PASSCODE=

# ── Market data / accounts ───────────────────────────────────────────────
# toss = live Toss prices via the market-only keys below; empty = fixtures
MARKET_DATA_PROVIDER=
TOSS_MARKET_CLIENT_ID=
TOSS_MARKET_CLIENT_SECRET=
# read your own Toss account (ignored when PUBLIC_DEMO_MODE=true)
ENABLE_REAL_TOSS=false
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# TOSS_BASE_URL=
# demo MyData accounts shown when no holdings are entered
ENABLE_MOCK_MYDATA=true

# ── External evidence ────────────────────────────────────────────────────
ENABLE_EXTERNAL_EVIDENCE=false
# Korean filings (opendart.fss.or.kr)
DART_API_KEY=
# "Your Name you@example.com", required by SEC EDGAR
SEC_USER_AGENT=

# ── App ──────────────────────────────────────────────────────────────────
DATABASE_URL=file:./data/app.db
# e.g. https://my-ai-pb-jinmyoung.fly.dev behind a proxy
PUBLIC_APP_ORIGIN=
ENABLE_AGENT_TRACE=true
# Public demo: visitors answer only with a free OpenRouter model and a daily question quota.
# The owner signed in with OWNER_PASSCODE skips both: the LLM keys above when set, else the free model with no quota.
# Keep off for personal use.
PUBLIC_DEMO_MODE=false
# DEMO_LLM_MODEL=qwen/qwen3.8-27b:free
# DEMO_QUESTIONS_PER_DAY=5

# ── Evals (npm run eval) ─────────────────────────────────────────────────
# EVAL_DATABASE_URL=file:./data/eval.db
# JUDGE_PROVIDER=
# JUDGE_MODEL=
# EVAL_LATENCY_BUDGET_MS=
# EVAL_COST_BUDGET_USD=
